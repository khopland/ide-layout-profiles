<idea-plugin>
    <id>io.github.khopland.ide-layout-profiles</id>
    <name>IDE Layout Profiles</name>
    <vendor>khopland</vendor>

    <description><![CDATA[
        Save, update, and recall IntelliJ layout profiles from the keyboard.
        Profiles are shared across projects and include tool windows, the main toolbar,
        navigation bar, tool-window bars, and status bar widgets.
        ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <resource-bundle>messages.LayoutProfilesBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="IDE Layout Profiles" displayType="BALLOON" isLogByDefault="true"/>
    </extensions>

    <actions>
        <group id="io.github.khopland.ideLayoutProfiles.actions" text="Layout Profiles" popup="true">
            <add-to-group group-id="WindowMenu" anchor="after" relative-to-action="LayoutsGroup"/>

            <action id="io.github.khopland.ideLayoutProfiles.applySlot1"
                    class="io.github.khopland.ApplySlot1Action"
                    text="Apply Slot 1"/>
            <action id="io.github.khopland.ideLayoutProfiles.applySlot2"
                    class="io.github.khopland.ApplySlot2Action"
                    text="Apply Slot 2"/>
            <action id="io.github.khopland.ideLayoutProfiles.applySlot3"
                    class="io.github.khopland.ApplySlot3Action"
                    text="Apply Slot 3"/>
            <action id="io.github.khopland.ideLayoutProfiles.applySlot4"
                    class="io.github.khopland.ApplySlot4Action"
                    text="Apply Slot 4"/>
            <action id="io.github.khopland.ideLayoutProfiles.applySlot5"
                    class="io.github.khopland.ApplySlot5Action"
                    text="Apply Slot 5"/>

            <separator/>
            <action id="io.github.khopland.ideLayoutProfiles.saveNew"
                    class="io.github.khopland.SaveNewLayoutProfileAction"
                    text="Save Current as New Layout Profile"/>
            <action id="io.github.khopland.ideLayoutProfiles.updateActive"
                    class="io.github.khopland.UpdateActiveLayoutProfileAction"
                    text="Update Active Layout Profile"/>
            <separator/>
            <action id="io.github.khopland.ideLayoutProfiles.manage"
                    class="io.github.khopland.ManageLayoutProfilesAction"
                    text="Manage Layout Profiles…"/>
        </group>
    </actions>
</idea-plugin>
